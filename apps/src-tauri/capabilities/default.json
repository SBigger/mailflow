{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Enables default permissions including dynamic window creation for smartis",
  "windows": [
    "main",
    "app-*"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-create"
  ],
  "remote": {
    "urls": [
      "https://*.sm-artis.ch"
    ]
  }
}