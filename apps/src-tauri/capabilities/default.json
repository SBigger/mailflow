[
  {
    "identifier": "custom-app-permissions",
    "description": "Definiert und erlaubt eigene App Commands",
    "windows": [
      "main",
      "app-*",
      "oauth-*",
      "embed-*"
    ],
    "permissions": [
      "core:default",
      "notification:default",
      "core:webview:allow-create-webview-window",
      "core:window:allow-create",
      "opener:default",
      "allow-open-oauth-window"
    ],
    "remote": {
      "urls": [
        "https://*.sm-artis.ch"
      ]
    }
  },
  {
    "identifier": "popup-fenster-schliessen",
    "description": "Nur Neben- und Popup-Fenster duerfen sich selbst schliessen. Das Hauptfenster bewusst NICHT, sonst wuerde ein Schliessen-Knopf die ganze App beenden.",
    "windows": [
      "app-*",
      "oauth-*",
      "embed-*"
    ],
    "permissions": [
      "core:window:allow-close"
    ],
    "remote": {
      "urls": [
        "https://*.sm-artis.ch"
      ]
    }
  }
]
