{
  "name": "@artis/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lokaler MCP-Server fuer die artis.sm-artis.ch Treuhand-Plattform (Supabase). RevDSG-konform: Rohdaten bleiben in der Schweiz.",
  "bin": {
    "artis-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "@supabase/supabase-js": "^2.48.0",
    "dotenv": "^16.4.7",
    "pdf-lib": "^1.17.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
