<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">
  <Id>7c3a1e6e-9d2b-4a1f-9b54-5f3e2a7c8d10</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Artis Treuhand GmbH</ProviderName>
  <DefaultLocale>de-CH</DefaultLocale>
  <DisplayName DefaultValue="Smartis Ablage" />
  <Description DefaultValue="Dateien aus der Smartis-Dateiablage direkt in eine E-Mail einfügen." />
  <IconUrl DefaultValue="https://docs.smartis.me/outlook/assets/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="https://docs.smartis.me/outlook/assets/icon-128.png" />
  <SupportUrl DefaultValue="https://docs.smartis.me" />
  <AppDomains>
    <AppDomain>https://docs.smartis.me</AppDomain>
    <AppDomain>https://uawgpxcihixqxqxxbjak.supabase.co</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.3" />
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://docs.smartis.me/outlook/index.html" />
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit" />
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="taskpaneUrl" />
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="smartisGroup">
                <Label resid="groupLabel" />
                <Control xsi:type="Button" id="openSmartisAblage">
                  <Label resid="btnLabel" />
                  <Supertip>
                    <Title resid="btnLabel" />
                    <Description resid="btnTip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="taskpaneUrl" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="icon16" DefaultValue="https://docs.smartis.me/outlook/assets/icon-16.png" />
        <bt:Image id="icon32" DefaultValue="https://docs.smartis.me/outlook/assets/icon-32.png" />
        <bt:Image id="icon80" DefaultValue="https://docs.smartis.me/outlook/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="taskpaneUrl" DefaultValue="https://docs.smartis.me/outlook/index.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="groupLabel" DefaultValue="Smartis" />
        <bt:String id="btnLabel" DefaultValue="Ablage einfügen" />
        <bt:String id="btnTip" DefaultValue="Datei aus der Smartis-Dateiablage an diese E-Mail anhängen." />
      </bt:ShortStrings>
      <bt:LongStrings />
    </Resources>
  </VersionOverrides>
</OfficeApp>
